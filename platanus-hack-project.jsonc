{
  // Your project's name, as it will appear on the voting page.
  "project-name": "WOKI",

  // Short one-line summary of your project (in Spanish).
  "project-oneliner-spanish": "Pedir ayuda y coordinar rescates sin internet, con visibilidad remota cuando vuelve la red.",

  // Brief description of your project (in Spanish).
  "project-description-spanish": "WOKI mantiene abierta la comunicación cuando cae internet. Un civil se conecta sin app al WiFi de un nodo TTGO, reporta la emergencia y el mensaje viaja por LoRa 915 MHz hasta un command center local en Raspberry Pi. El centro conserva los datos en SQLite, prioriza, recomienda recursos y coordina el ciclo hasta la resolución con autorización humana. Cuando vuelve la conectividad, una cola durable sincroniza automáticamente los eventos con un hub online de solo lectura, sin convertir la nube en una dependencia operacional.",

  // Public URL where your project is deployed and running.
  // Must be a valid URL, for example: https://my-project.vercel.app
  // If your project is an app, put the download link here instead
  // (for example, a URL to download an APK).
  "deploy-url": "https://woki-hub.vercel.app"
}
